# Firebase web config — safe to expose client-side by design (restricted by Firebase Security Rules, not secrecy).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# UI-only gate for showing the Admin Panel. NOT a security boundary — enforce admin
# access with Firestore Security Rules (see firestore.rules), not this list.
VITE_ADMIN_EMAILS=

# Server-only Gemini key. No VITE_ prefix — Vite inlines VITE_* vars into the public
# bundle, so this must stay out of client code and only be read inside api/*.js.
GEMINI_API_KEY=
